# Pulse banking app: builds the React frontend, then serves it together with the FastAPI
# backend from a single container (see app/server.py). Used for the Cloud Run deployment.

FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim

# apply upstream Debian security patches at build time, since the base image tag
# itself is not rebuilt often enough to stay ahead of newly disclosed OS CVEs
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY src/ src/
COPY app/ app/
COPY scripts/ scripts/

RUN pip install --no-cache-dir ".[api]"

RUN python scripts/build_demo_data.py

COPY --from=web /web/dist web/dist

# Cloud Run injects PORT; 8080 is its default.
ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uvicorn server:app --app-dir app --host 0.0.0.0 --port ${PORT}"]
